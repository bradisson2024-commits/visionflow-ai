{
  "manifest_version": 3,
  "name": "Cenit · Flow",
  "short_name": "Cenit Flow",
  "version": "2.0.2",
  "description": "Cenit Studio: crea en Google Flow, con tu cuenta, las imágenes de tus escenas y personajes y las coloca solas en Cenit.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Cenit · Flow (en Google Flow: pulsa para volver a enseñarle el cuadro y la flecha)", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "scripting", "debugger", "storage"],
  "host_permissions": [
    "http://localhost/*", "http://127.0.0.1/*",
    "https://flow.google.com/*", "https://labs.google/*",
    "https://*.googleusercontent.com/*", "https://*.googleapis.com/*", "https://*.ggpht.com/*"
  ],
  "content_scripts": [
    { "matches": ["http://localhost/*", "http://127.0.0.1/*"], "js": ["cenit-page.js"], "run_at": "document_start" },
    { "matches": ["https://flow.google.com/*", "https://labs.google/fx/*"], "js": ["flow-page.js"], "run_at": "document_idle" }
  ]
}
