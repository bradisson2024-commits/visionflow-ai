# ===================== Cenit Studio · configuración del SERVIDOR =====================
# Copia este archivo como .env. Las claves nunca se envían al navegador.
PORT=8080
# HOST=0.0.0.0   # para aceptar conexiones de otros equipos (ponlo detrás de HTTPS)

# --- Base de datos (Supabase → Project Settings → Database → Connection string, modo «Session pooler»)
DATABASE_URL=postgresql://postgres.xxxxxxxx:CONTRASEÑA@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# --- Supabase Auth y Storage (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: sólo para proyectos que aún firman con el secreto JWT heredado (Settings → JWT Keys)
SUPABASE_JWT_SECRET=
# Bucket privado de Storage (créalo en Storage → New bucket, sin acceso público)
SUPABASE_STORAGE_BUCKET=cenit

# --- Sin Supabase (pruebas locales): cuentas propias. Pon un secreto largo y aleatorio.
# Si SUPABASE_URL y SUPABASE_ANON_KEY están vacíos se usan cuentas locales.
LOCAL_JWT_SECRET=

# Correos que serán administradores (recargan créditos y cambian tarifas). Con cuentas locales,
# el primer usuario registrado también es administrador.
ADMIN_EMAILS=
INITIAL_CREDITS=20000

# --- YouTube Data API v3 (Google Cloud Console → APIs y servicios → YouTube Data API v3 → Credenciales)
YOUTUBE_API_KEY=

# --- Google Gemini (aistudio.google.com/apikey): guiones, análisis, imágenes, voz y animación Veo.
# Las imágenes y Veo pueden requerir facturación activa en Google AI Studio.
GEMINI_API_KEY=

# --- ElevenLabs (opcional): más voces
ELEVENLABS_API_KEY=

# --- FFmpeg (si no está en el PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Almacenamiento local (copia de trabajo y modo sin Supabase)
STORAGE_DIR=storage
# false = este proceso no ejecuta trabajos (usa «npm run worker» en otro proceso)
RUN_WORKER=true
