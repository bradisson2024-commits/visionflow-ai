# ===== ViralHunter AI — variables del SERVIDOR (nunca se envían al navegador) =====
PORT=8787

# PostgreSQL de Supabase: Project Settings → Database → Connection string (URI, modo "Session pooler")
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# YouTube Data API v3: console.cloud.google.com → APIs & Services → habilitar "YouTube Data API v3" → Credentials → API key
YOUTUBE_API_KEY=
# Cuota diaria de tu proyecto de Google (por defecto 10000 unidades)
YOUTUBE_DAILY_QUOTA=10000

# IA de texto y visión (Claude): console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Generación de imágenes. Por defecto GRATIS: pollinations (sin clave).
#   pollinations → gratis, sin registro (modelo FLUX). Token opcional para más límite: auth.pollinations.ai
#   huggingface  → gratis con HF_TOKEN (huggingface.co → Settings → Access Tokens)
#   openai       → de pago (OPENAI_API_KEY)
IMAGE_PROVIDER=pollinations
POLLINATIONS_MODEL=flux
POLLINATIONS_TOKEN=
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Síntesis de voz (ElevenLabs): elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Origen permitido para CORS en producción (opcional)
ALLOWED_ORIGIN=http://localhost:5173
