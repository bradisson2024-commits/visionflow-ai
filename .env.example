# Copia este archivo a .env y rellena las claves.
# --- Investigación (YouTube Data API v3, clave de API simple) ---
YOUTUBE_API_KEY=
# --- Guiones (API de Claude / Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# --- Imágenes de stock (Pexels, gratis) ---
PEXELS_API_KEY=
# --- Voz IA premium (opcional; si no, se usa edge-tts) ---
ELEVENLABS_API_KEY=
# --- Subida: ruta al JSON de cliente OAuth "Desktop app" de Google Cloud ---
YOUTUBE_CLIENT_SECRETS=credentials/client_secret.json
