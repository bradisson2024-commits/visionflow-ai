# ─────────────────────────────────────────────────────────────
# ClipForge AI — configuración del servidor
# Copia este archivo a `.env` y rellena los valores.
# NINGUNA de estas variables se envía al navegador.
# ─────────────────────────────────────────────────────────────

# Base de datos PostgreSQL
DATABASE_URL=postgres://clipforge:clipforge@localhost:5432/clipforge

# Redis (cola de trabajos en segundo plano, BullMQ)
REDIS_URL=redis://localhost:6379

# URL pública de la app (se usa para cookies seguras y enlaces)
APP_URL=http://localhost:3000

# ── Almacenamiento ───────────────────────────────────────────
# local  → archivos en disco (STORAGE_LOCAL_DIR)
# s3     → cualquier servicio compatible con S3 (AWS S3, Cloudflare R2,
#          MinIO, Supabase Storage vía su endpoint S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Tamaño máximo de subida (MB)
MAX_UPLOAD_MB=4096

# ── Transcripción ────────────────────────────────────────────
# openai        → OpenAI Whisper API (requiere OPENAI_API_KEY)
# groq          → Groq Whisper large-v3 (requiere GROQ_API_KEY)
# deepgram      → Deepgram Nova (requiere DEEPGRAM_API_KEY)
# local         → Whisper en el servidor con sherpa-onnx (sin coste por uso;
#                 requiere Python + `pip install sherpa-onnx numpy` y
#                 `bash scripts/download-models.sh`)
TRANSCRIPTION_PROVIDER=local
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
PYTHON_PATH=python3
LOCAL_WHISPER_MODEL_DIR=./models/sherpa-onnx-whisper-base
LOCAL_VAD_MODEL=./models/silero_vad.onnx
LOCAL_WHISPER_THREADS=4

# ── IA para análisis de momentos y puntuación ────────────────
# anthropic          → Claude (requiere ANTHROPIC_API_KEY)
# openai             → OpenAI (requiere OPENAI_API_KEY)
# openai_compatible  → cualquier API compatible con OpenAI (Groq, OpenRouter,
#                      Ollama local, etc.) usando LLM_BASE_URL + LLM_API_KEY
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
# Profundidad del razonamiento en Claude: low | medium | high | xhigh | max
LLM_EFFORT=high

# ── Procesamiento ────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Trabajos simultáneos que ejecuta cada worker
WORKER_CONCURRENCY=1

# Sólo para pruebas locales: permite importar enlaces de la red interna (desactiva la protección SSRF)
IMPORT_ALLOW_PRIVATE_HOSTS=false
