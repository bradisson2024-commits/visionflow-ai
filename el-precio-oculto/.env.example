# ===== El Precio Oculto · Viral Finder — copia este archivo como .env y rellena lo que tengas =====
# Las claves sólo las lee el servidor local; nunca se envían al navegador.
PORT=8790

# --- YouTube Data API v3 (GRATIS) — buscador de virales + vistas, fecha, duración reales
# console.cloud.google.com → APIs y servicios → Biblioteca → «YouTube Data API v3» → Habilitar → Credenciales → Crear clave de API
YOUTUBE_API_KEY=

# --- Google Gemini (GRATIS, sin tarjeta: aistudio.google.com/apikey)
# Activa: transcripción del video original (Gemini procesa el video público), búsqueda en Google con fuentes,
# análisis de la miniatura y REVISIÓN AUTOMÁTICA DE COHERENCIA imagen↔narración. Muy recomendada.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Imágenes con Gemini (usa la hoja de personajes como referencia = mejor consistencia). Puede requerir facturación.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Charon

# --- Claude (opcional, de pago) — alternativa a Gemini para texto, visión y búsqueda web
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Proveedores: auto | gemini | anthropic | pollinations
LLM_PROVIDER=auto
# Imágenes: flow (Google Flow vía la extensión de extension-flow/, por defecto) | gemini | pollinations
IMAGE_PROVIDER=flow
# Pollinations sin token: gratis pero lento (texto 1 respuesta/45 s, imágenes ~1 cada 16 s) y con marca de agua.
# Token gratuito en https://enter.pollinations.ai → quita la marca y los límites.
POLLINATIONS_TOKEN=

# --- Voz: edge (gratis, por defecto) | elevenlabs | gemini
TTS_PROVIDER=auto
# Microsoft Edge neural TTS (sin clave). Voces de español latino: es-MX-JorgeNeural, es-MX-DaliaNeural,
# es-CO-GonzaloNeural, es-AR-TomasNeural, es-US-AlonsoNeural
EDGE_TTS_VOICE=es-MX-JorgeNeural
EDGE_TTS_RATE=+4%
# ElevenLabs (de pago): se usa automáticamente si hay clave + voz
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- FFmpeg (si no está en el PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Duración objetivo del video (minutos)
TARGET_MIN_MINUTES=8
TARGET_MAX_MINUTES=10

# --- Música: carpeta con pistas instrumentales con licencia (si está vacía se compone una pista ambiental con FFmpeg)
MUSIC_DIR=assets/music
PROJECTS_DIR=projects

# Opcional: protege la API local con un token (cabecera x-access-token)
APP_ACCESS_TOKEN=
