{
  "manifest_version": 3,
  "name": "RaulitoShow IA — El Precio Oculto (Google Flow)",
  "short_name": "RaulitoShow IA",
  "version": "1.3.1",
  "description": "Genera en Google Flow las imágenes Stickman de cada escena de El Precio Oculto y las devuelve a su escena en la app local.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Abrir RaulitoShow IA",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.googleapis.com/*",
    "https://*.gstatic.com/*",
    "http://127.0.0.1:8790/*",
    "http://localhost:8790/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*"
      ],
      "js": [
        "picker-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*"
      ],
      "js": [
        "config.js",
        "engine.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "version_name": "1.3.1 · El Precio Oculto"
}