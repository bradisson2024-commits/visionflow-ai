# Ajustes opcionales de ClipForge (instalación con Docker).
# Copia este archivo como «clipforge.env» y cambia lo que necesites.

# Modelo de IA gratuito (Ollama). Con 16 GB de RAM o más: qwen2.5:14b
CF_LLM_MODEL=qwen2.5:7b

# Proveedor de IA: ollama (gratis) | anthropic | openai
CF_LLM_PROVIDER=ollama
# CF_ANTHROPIC_API_KEY=

# Transcripción: local (gratis) | openai | groq | deepgram
CF_TRANSCRIPTION_PROVIDER=local
# CF_GROQ_API_KEY=
# CF_OPENAI_API_KEY=
# CF_DEEPGRAM_API_KEY=

# Importar desde YouTube y otras plataformas (true/false)
CF_PLATFORM_IMPORT_ENABLED=true
