# Ajustes opcionales de ClipForge (instalación con Docker).
# Copia este archivo como «clipforge.env», cambia lo que necesites y vuelve a ejecutar «iniciar».
# Escribe los valores sin comillas y sin espacios alrededor del «=».

# ── IA que elige los momentos virales ─────────────────────────
# Opción A (por defecto): IA local gratuita con Ollama. Necesita unos 8 GB de RAM en el equipo.
CF_LLM_PROVIDER=ollama
CF_LLM_MODEL=qwen2.5:7b

# Opción B: equipos con 4 GB de RAM → modelo local pequeño (gratis, menos acierto):
# CF_LLM_PROVIDER=ollama
# CF_LLM_MODEL=qwen2.5:1.5b
# CF_OLLAMA_NUM_CTX=4096
# CF_LLM_WINDOW_WORDS=1200

# Opción C: IA en la nube compatible con OpenAI (Groq, Google Gemini, OpenRouter…).
# Algunos tienen plan gratuito con límites de uso; revisa sus condiciones.
# Los nombres de modelo son EJEMPLOS: usa el que indique la web del proveedor.
# Groq:
# CF_LLM_PROVIDER=openai_compatible
# CF_LLM_BASE_URL=https://api.groq.com/openai/v1
# CF_LLM_MODEL=llama-3.3-70b-versatile
# CF_LLM_API_KEY=tu_clave_de_groq
# Google Gemini:
# CF_LLM_PROVIDER=openai_compatible
# CF_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# CF_LLM_MODEL=gemini-2.5-flash
# CF_LLM_API_KEY=tu_clave_de_gemini

# Opción D: Claude (Anthropic, de pago por uso)
# CF_LLM_PROVIDER=anthropic
# CF_ANTHROPIC_API_KEY=

# ── Transcripción ─────────────────────────────────────────────
# local (gratis, en tu equipo) | groq | openai | deepgram
CF_TRANSCRIPTION_PROVIDER=local
# Con Groq la transcripción es más rápida y los subtítulos van exactamente sincronizados:
# CF_TRANSCRIPTION_PROVIDER=groq
# CF_GROQ_API_KEY=tu_clave_de_groq
# CF_OPENAI_API_KEY=
# CF_DEEPGRAM_API_KEY=

# ── Importar desde YouTube y otras plataformas (true/false) ──
CF_PLATFORM_IMPORT_ENABLED=true
